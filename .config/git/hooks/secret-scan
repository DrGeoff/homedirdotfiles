#!/usr/bin/env bash
# secret-scan — block staged secrets before they reach a (public) commit.
#
# Scans the staged diff of the current repo and exits non-zero if it looks like
# a secret is being introduced. Prints only file names and a label — never the
# matched value. Used by the pre-commit hook, but also runnable standalone in
# any git repo (it relies on the ambient git environment).
set -u

# "label:extended-regex" — curated, high-confidence patterns to avoid noise.
labels=(
  "OpenAI key:sk-[A-Za-z0-9]{20,}"
  "GitHub token:gh[pousr]_[A-Za-z0-9]{20,}"
  "GitHub fine-grained PAT:github_pat_[A-Za-z0-9_]{20,}"
  "AWS access key:AKIA[0-9A-Z]{16}"
  "PyPI token:pypi-[A-Za-z0-9_-]{20,}"
  "Slack token:xox[baprs]-[A-Za-z0-9-]{10,}"
  "Google API key:AIza[0-9A-Za-z_-]{35}"
  "Private key block:-----BEGIN [A-Z ]*PRIVATE KEY-----"
  "Bearer token:Bearer[[:space:]]+[A-Za-z0-9._-]{20,}"
)
# Paths that must never be committed regardless of content.
blocked_paths='(^|/)\.secrets/|(^|/)secret\.local$'

rc=0

# 1) refuse secret-store paths outright
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if printf '%s\n' "$f" | grep -qE -- "$blocked_paths"; then
    echo "secret-scan: refusing to commit secret-store path: $f" >&2
    rc=1
  fi
done < <(git diff --cached --name-only)

# 2) scan added lines, per file (values are never printed)
while IFS= read -r f; do
  [ -n "$f" ] || continue
  add="$(git diff --cached --unified=0 --no-color -- "$f" | grep '^+' | grep -v '^+++')"
  [ -n "$add" ] || continue
  for entry in "${labels[@]}"; do
    label="${entry%%:*}"; rx="${entry#*:}"
    if printf '%s' "$add" | grep -qE -- "$rx"; then
      echo "secret-scan: possible ${label} in staged change to: $f" >&2
      rc=1
    fi
  done
done < <(git diff --cached --name-only --diff-filter=AM)

if [ "$rc" -ne 0 ]; then
  echo "secret-scan: commit blocked. Move secrets into KeePassXC and reference" >&2
  echo "             them via secret(); override with 'git commit --no-verify'" >&2
  echo "             only if you are certain this is a false positive." >&2
fi
exit "$rc"
