# secret — backend-agnostic secret retrieval for shell/CLI use.
#
#   secret <name> [attribute]   # print a secret value (memoised per shell)
#   withsecret VAR=name [..] -- cmd args    # (defined in ~/.bashrc.d/withsecret)
#
# Backends tried in order: keepassxc-cli -> ~/.secrets/<name> plaintext.
# (A keepassxc-proxy tier is added in a later task.)
#
# Values are cached per shell in __SECRET_CACHE. The KeePassXC master password
# is never cached: secret() prompts once per distinct secret per shell, while
# withsecret prompts once per call for all its uncached secrets (_secret_prefetch).

: "${KPXC_DB:=$HOME/.bashrc.d/.keepass-db-path-not-set}"
: "${SECRETS_DIR:=$HOME/.secrets}"

declare -A __SECRET_CACHE 2>/dev/null

_secret_check_perms() {
    # Refuse to read ~/.secrets unless it is 700 (owner-only).
    local mode
    mode="$(stat -c '%a' "$SECRETS_DIR" 2>/dev/null)" || return 0
    if [[ "$mode" == "700" ]]; then
        return 0
    fi
    echo "secret: $SECRETS_DIR has unsafe perms ($mode); want 700" >&2
    return 1
}

_secret_cli() {
    # $1=entry name, $2=attribute. Prompts for the DB password on the tty.
    keepassxc-cli show -s -a "$2" "$KPXC_DB" "$1"
}

# Reads a KeePassXC CSV export on stdin and, for each entry path in argv,
# writes "path\0password\0". Writes "ok\0" first iff the export parsed (i.e. the
# unlock succeeded). Paths drop the root group, whose name varies by vault.
_SECRET_PICK='
import csv, io, sys
rows = csv.DictReader(io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", newline=""))
if not rows.fieldnames:
    sys.exit(1)
want = {n.strip("/"): n for n in sys.argv[1:]}
sys.stdout.write("ok\0")
for r in rows:
    path = "/".join(r["Group"].split("/", 1)[1:] + [r["Title"]])
    if path in want:
        sys.stdout.write(want.pop(path) + "\0" + r["Password"].rstrip("\n") + "\0")
'

_secret_prefetch() {
    # $@=entry names. Unlock the DB once (each unlock costs seconds of KDF) and
    # cache every uncached entry's Password from a single export. A wrong
    # password is re-asked once, then we give up (return 1). The password lives
    # only in this local. Entries not in the vault are left for secret().
    command -v keepassxc-cli >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1 \
        && [[ -r "$KPXC_DB" ]] || return 0
    local -a todo=()
    local n v pw status try
    for n in "$@"; do
        [[ -n "${__SECRET_CACHE[$n/Password]+set}" ]] || todo+=("$n")
    done
    (( ${#todo[@]} )) || return 0
    for try in 1 2; do
        read -rs -p "Enter password to unlock $KPXC_DB: " pw || return 0
        [[ -t 0 ]] && echo >&2
        status=""
        {
            IFS= read -r -d '' status
            while IFS= read -r -d '' n && IFS= read -r -d '' v; do
                __SECRET_CACHE[$n/Password]="$v"
            done
        } < <(printf '%s\n' "$pw" | keepassxc-cli export -q -f csv "$KPXC_DB" 2>/dev/null \
                | python3 -I -c "$_SECRET_PICK" "${todo[@]}")
        [[ "$status" == ok ]] && return 0
        echo "secret: could not unlock $KPXC_DB (wrong password?)" >&2
    done
    return 1
}

secret() {
    local name="$1" attr="${2:-Password}"
    if [[ -z "$name" ]]; then
        echo "usage: secret <name> [attribute]" >&2
        return 2
    fi

    local key="${name}/${attr}"
    if [[ -n "${__SECRET_CACHE[$key]+set}" ]]; then
        printf '%s' "${__SECRET_CACHE[$key]}"
        return 0
    fi

    local value=""

    # 1) keepassxc-cli against the .kdbx
    if [[ -z "$value" ]] && command -v keepassxc-cli >/dev/null 2>&1 && [[ -r "$KPXC_DB" ]]; then
        value="$(_secret_cli "$name" "$attr")"
    fi

    # 2) plaintext fallback
    if [[ -z "$value" ]] && [[ -r "$SECRETS_DIR/$name" ]]; then
        _secret_check_perms || return 1
        value="$(<"$SECRETS_DIR/$name")"
    fi

    if [[ -z "$value" ]]; then
        echo "secret: could not retrieve '$name'" >&2
        return 1
    fi

    __SECRET_CACHE[$key]="$value"
    printf '%s' "$value"
}
