mvd() { 
    numfiles="$1"

    # Check if $1 is provided and is a positive integer
    if ! [[ "$numfiles" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: Please provide a positive integer as an argument."
        return 1
    fi

    # Safely list and move the latest 'numfiles' files from ~/Downloads
    find ~/Downloads -maxdepth 1 -type f -printf '%T@ %p\0' \
    | sort -zn \
    | tail -z -n "$numfiles" \
    | cut -z -d' ' -f2- \
    | xargs -0 -I{} mv "{}" .
}

