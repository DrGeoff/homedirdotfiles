# withsecret VAR=name [VAR2=name2 ...] -- cmd args...
# Run `cmd` with the named secrets exported only into that one process, rather
# than into the shell environment. Values come from secret() (see ~/.bashrc.d/secret).
withsecret() {
    local -a assigns=() envv=()
    while [[ $# -gt 0 && "$1" != "--" ]]; do assigns+=("$1"); shift; done
    [[ "$1" == "--" ]] && shift
    if [[ $# -eq 0 ]]; then
        echo "usage: withsecret VAR=name [...] -- cmd args" >&2
        return 2
    fi
    local a var name val
    for a in "${assigns[@]}"; do
        var="${a%%=*}"; name="${a#*=}"
        val="$(secret "$name")" || return 1
        envv+=("$var=$val")
    done
    env "${envv[@]}" "$@"
}
