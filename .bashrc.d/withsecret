# withsecret VAR=name [VAR2=name2 ...] -- cmd args...
# Run `cmd` with the named secrets exported only into that one process, rather
# than into the shell environment. Values come from secret() (see ~/.bashrc.d/secret).
withsecret() {
    local -a assigns=() envv=()
    while [[ $# -gt 0 && "$1" != "--" ]]; do assigns+=("$1"); shift; done
    [[ "$1" == "--" ]] && shift
    if [[ $# -eq 0 ]]; then
        echo "usage: withsecret VAR=name [...] -- cmd args" >&2
        return 2
    fi
    local a var name
    # One vault unlock for every secret this call needs.
    _secret_prefetch "${assigns[@]#*=}" || return 1
    for a in "${assigns[@]}"; do
        var="${a%%=*}"; name="${a#*=}"
        # Call secret() in this shell (not via $(...)) so its cache persists and
        # the KeePassXC password is only asked once per shell.
        secret "$name" >/dev/null || return 1
        envv+=("$var=${__SECRET_CACHE[$name/Password]}")
    done
    env "${envv[@]}" "$@"
}
