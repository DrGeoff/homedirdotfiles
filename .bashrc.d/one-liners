check_source()
{
    if [[ -f "$1" ]]; then
        source "$1"
    fi
}

# Interactive-only: an exported CDPATH makes `cd` print paths inside scripts and
# breaks `$(cd dir && pwd)`. -n also un-exports one inherited from a parent shell.
export -n CDPATH="."
export PATH=$HOME/compiletools:$HOME/.npm-global/bin:$HOME/bin:/home/geoff/code/llama.cpp/build/bin:$PATH
export TZ=:/etc/localtime
export SSH_ASKPASS=/usr/libexec/openssh/gnome-ssh-askpass
export GIT_ASKPASS=/usr/libexec/openssh/gnome-ssh-askpass

alias ll='ls -l'
alias xo='xdg-open'

